{% macro runView(home, currentMenu) %}
    <div class="View1">
        <h1 class="View2">{{ currentMenu.m_title }}</h1>
        <div class="View3">
            <div>
                <div class="View4">
                    <div class="View6">
                        <i class="fa fa-eye"></i> Vues
                    </div>
                    <div class="View7">{{ home.getViewCount() }}</div>
                </div>
            </div>
            <div>
                <a href="{{ home.getFacebookShareUrl() }}" target="_blank"><i class="View5 Facebook fa fa-facebook"></i></a>
                <a href="{{ home.getLinkedInShareUrl() }}" target="_blank"><i class="View5 Linkedin fa fa-linkedin"></i></a>
            </div>
        </div>
    </div>
{% endmacro %}

