{% macro runBackground() %}
    <div class="Background1"></div>
    <div class="Background2"></div>
    <div class="Background3"></div>
{% endmacro %}

{% macro runHeader(home, menuList, currentMenu) %}
    <header class="Menu1" id="HeaderMenu">
        <a class="Menu3" href="{{ home.homePage }}">
            <img class="Menu4" src="{{ home.pageLogo }}" alt="logo.png"/>
            <span class="Menu5">{{ home.siteName }}</span>
        </a>
        {{ _self.runHeaderMenu(menuList, currentMenu, 0) }}
        <div class="Bars1" onclick="callBackend('app', 'open_menu_bars', this)" data-is-opened="false">
            <i class="fa fa-bars"></i>
        </div>
    </header>
{% endmacro %}

{% macro runHeaderMenu(menuList, currentMenu, parentIndex) %}
    {% set menuListI = menuList.getMenuListByParentIndex(parentIndex) %}
    {% for menuI in menuListI.getMenuList() %}
        {% if menuI.m_isActive %}
            {% set menuListJ = menuList.getMenuListByParentIndex(menuI.m_index) %}
            {% set activeClass = '' %}
            {% set isActive = false %}
            {% set isActive = (isActive or menuI.isEqual(currentMenu)) %}
            {% set isActive = (isActive or ((menuI.m_name == currentMenu.m_name) and (menuI.m_parentIndex ==0))) %}
            {% if isActive %}
                {% set activeClass = ' Active' %}
            {% endif %}
            {% if menuListJ.isEmpty() %}
                {% if menuI.m_parentIndex == 0 %}
                    <a class='Menu2{{ activeClass }}' href='{{ menuI.m_link }}'><div class='Menu14'>{{ menuI.m_label }}</div></a>
                {% else %}
                    <a class='Menu10' href='{{ menuI.m_link }}'><div class='Menu8{{ activeClass }}'>{{ menuI.m_label }}</div></a>
                {% endif %}
            {% else %}
                {% if menuI.m_parentIndex == 0 %}
                    <div class='Menu6'><a class='Menu2{{ activeClass }}' href='{{ menuI.m_link }}' onclick='return callBackend("app", "open_menu_group", this)'><div class='Menu14'>{{ menuI.m_label }}</div><i class='Menu13 fa fa-caret-down'></i></a>
                {% else %}
                    <div class='Menu9'><div class='Menu12'><div class='Menu8'>{{ menuI.m_label }} <i class='Menu15 fa fa-caret-down'></i></div></div>
                {% endif %}

                {% if menuI.m_parentIndex == 0 %}
                    <div class='Menu7'><a class='Menu16' href='{{ menuI.m_link }}'><div class='Menu8'>{{ menuI.m_label }}</div></a>
                {% else %}
                    <div class='Menu11'>
                    {% endif %}
                    {{ _self.runHeaderSubMenu(menuList, currentMenu, menuI.m_index) }}
                </div>
                </div>
            {% endif %}
        {% endif %}
    {% endfor %}
{% endmacro %}

