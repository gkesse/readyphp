{% macro runSiteInfo(home) %}
    <title>{{ home.getPageTitle() }}</title>
    <meta charset="{{ home.getPageEncoding() }}" />
    <link rel="shortcut icon" type="{{ home.getPageLogoMimeType() }}" href="{{ home.getPageLogo() }}"/>
    <meta name="description" content="{{ home.getPageDescription() }}" />
{% endmacro %}

{% macro runOpenGraph(home) %}
    <meta property="og:type" content="{{ home.getOpenGraphType() }}" />
    <meta property="og:image" content="{{ home.getOpenGraphImage() }}" />
    <meta property="og:image:secure_url" content="{{ home.getOpenGraphImage() }}"/>
    <meta property="og:image:type" content="{{ home.getOpenGraphImageMimeType() }}"/>
    <meta property="og:image:width" content="{{ home.getOpenGraphImageWidth() }}"/>
    <meta property="og:image:height" content="{{ home.getOpenGraphImageHeight() }}"/>
    <meta property="og:locale" content="{{ home.getOpenGraphLocale() }}" />
    <meta property="og:url" content="{{ home.getPageUrl() }}" />
    <meta property="og:title" content="{{ home.getPageTitle() }}" />
    <meta property="og:site_name" content="{{ home.getSiteName() }}" />
    <meta property="og:description" content="{{ home.getPageDescription() }}"/>
{% endmacro %}

